* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    background-color: #050875;
    font-family: Arial, Helvetica, sans-serif;
}

header {
    width: 100%;
    height: 100px;
    background-color: #4d84c4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
}

header h1 {
    color: white;
    font-size: 32px;
    font-weight: normal;
    text-align: center;
}

.icone {
    position: absolute;
    left: 30px;
    width: 60px;
    height: 60px;
    background-color: #4a4a3d;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
}

.menu {
    position: absolute;
    right: 25px;
    width: 60px;
    height: 60px;
    background-color: #777777;
    border-radius: 8px;
    color: white;
    font-size: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
}

main {
    width: 100%;
    min-height: calc(100vh - 100px);
    padding: 60px 40px;
}

.cards {
    width: 100%;
    max-width: 1250px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 45px;
}

.card {
    width: 250px;
    height: 390px;
    background-color: #15c5c5;
    box-shadow: 0 4px 10px rgba(255, 255, 255, 0.3);
    overflow: hidden;
}

.titulo-card {
    width: 100%;
    height: 105px;
    background-color: #858585;
    color: white;
    font-size: 24px;
    font-weight: normal;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.area-consumo {
    width: 190px;
    height: 220px;
    background-color: white;
    margin: 30px auto;
    position: relative;
    padding-top: 25px;
}

.area-consumo p {
    color: #555555;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 20px;
    line-height: 1.1;
    text-align: center;
}

.grafico {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 20px;
    height: 110px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 15px;
}

.barra {
    width: 35px;
    background-color: #fff000;
    border: 1px solid #d4c800;
    display: block;
}

.barra1 {
    height: 85px;
}

.barra2 {
    height: 50px;
}

.barra3 {
    height: 70px;
}